  "$id": "https://schemas.lamp-ops.dev/lamp-config.json",
  "additionalProperties": false,
  "description": "Root model for lamp_config.yaml.",
  "properties": {
    "assets": {
      "$ref": "#/$defs/AssetsConfig"
    },
    "dab_resource_path": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Bundle resource YAML directory, relative to the configuration file.",
      "title": "Dab Resource Path"
    },
    "lamp_policies": {
      "description": "Policy checks; also the only key of policy YAML files. SQL paths are relative to the file declaring them. Used when neither --policy-path nor LAMP_POLICY_PATH is set.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/SqlCheck"
          },
          {
            "$ref": "#/$defs/DenyResourceCheck"
          },
          {
            "$ref": "#/$defs/RequireTagsCheck"
          },
          {
            "$ref": "#/$defs/RequirePresetTagsCheck"
          },
          {
            "$ref": "#/$defs/RequirePermissionsCheck"
          },
          {
            "$ref": "#/$defs/RequireBundlePermissionsCheck"
          },
          {
            "$ref": "#/$defs/RequireMutatorsCheck"
          },
          {
            "$ref": "#/$defs/RequireFieldsCheck"
          },
          {
            "$ref": "#/$defs/ForbidFieldsCheck"
          },
          {
            "$ref": "#/$defs/AllowedFieldValuesCheck"
          }
        ]
      },
      "title": "Lamp Policies",
      "type": "array"
    },
    "lint": {
      "$ref": "#/$defs/LintConfig"
    },
    "policy_path": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Policy checks directory, YAML or SQL file, relative to the configuration file; defaults to an existing policies directory beside it. Used when neither --policy-path nor LAMP_POLICY_PATH is set.",
      "title": "Policy Path"
    },
    "root_path": {
      "default": ".",
      "description": "Root relative to this config file.",
      "format": "path",
      "title": "Root Path",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/SharedSettings",
      "description": "Promotion defaults shared by all assets."
    }
  },
  "title": "Lamp Configuration",
  "type": "object"
}
